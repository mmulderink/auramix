# Environment Configuration for Rat Assistant
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=your-api-key-here

# LLM Model to use (optional, default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Gemini API Key (optional, required for scam generation and reasoning)
GEMINI_API_KEY=your-gemini-api-key-here

# ElevenLabs API Key (optional, required for TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Neon Postgres connection string (optional, enables persistence)
NEON_DATABASE_URL=postgres://user:password@host/db

# Actian VectorAI URL (optional, falls back to in-memory if unset)
ACTIAN_URL=http://localhost:8765

# Backend server port (optional)
PORT=8000

# Frontend API and WebSocket endpoints (optional)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Frame streaming (optional)
FRAME_WIDTH=520
FRAME_HEIGHT=360
FRAME_FPS=12

# Debug logging (optional)
LLM_DEBUG=false
